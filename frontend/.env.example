# ============================================================
# 프론트엔드 환경 변수 (Vite)
#
# ⚠️ VITE_ 로 시작하는 변수는 빌드 결과물에 그대로 박힙니다.
#    브라우저에서 누구나 볼 수 있으므로 API 키나 비밀 값을 절대 넣지 마세요.
#    도서 API 키는 백엔드(SSM Parameter Store)에만 둡니다.
# ============================================================

# API 베이스 URL.
#
# CloudFront 단일 도메인 구성(권장)이면 **비워두세요.**
# 비어 있으면 프론트가 같은 도메인의 /api 를 상대 경로로 호출합니다.
#   → CORS 불필요, 설정 0
VITE_API_BASE=

# Lambda 함수 URL을 직접 호출하는 구성(02-aws-console-setup.md의 "대안 B")일 때만 사용:
# VITE_API_BASE=https://abcd1234.lambda-url.ap-northeast-2.on.aws


# ------------------------------------------------------------
# 로컬 개발용 (.env.local 에 넣으세요. git에 커밋하지 마세요)
# ------------------------------------------------------------
# vite dev server가 /api 요청을 이 주소로 프록시합니다.
# (Lambda 함수 URL 인증 유형을 임시로 NONE으로 바꿔야 동작합니다)
# VITE_DEV_PROXY_TARGET=https://abcd1234.lambda-url.ap-northeast-2.on.aws
