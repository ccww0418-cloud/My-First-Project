# ============================================================
# Lambda 환경 변수 (콘솔: Lambda > 구성 > 환경 변수)
# 이 파일은 "무엇을 넣어야 하는지" 참고용입니다.
# 실제 값은 Lambda 콘솔에 직접 입력하세요. 이 파일을 배포하지 마세요.
# ============================================================

# ---------- Bedrock ----------
# Bedrock을 호출할 리전. Lambda 리전과 달라도 됩니다.
BEDROCK_REGION=us-east-1

# 반드시 콘솔에서 실제 값을 확인해서 넣으세요.
#   Bedrock 콘솔 > 모델 카탈로그 > 모델 선택 > "Programmatic Access" 표
#   또는: npm run models
#
# ⚠️ ID 형식이 두 세대로 나뉩니다.
#
#   신형 (Claude Sonnet 4.6 이후) — 날짜/버전 접미사가 없습니다
#     anthropic.claude-sonnet-4-6            In-Region  (온디맨드 쿼터 최저)
#     us.anthropic.claude-sonnet-4-6         Geo(US)    us-east-1 권장
#     apac.anthropic.claude-sonnet-4-6       Geo(APAC)  서울 권장
#     global.anthropic.claude-sonnet-4-6     Global     처리량 최고, 약 10% 저렴
#
#   레거시 (Claude Opus 4.6 이전) — 날짜 + 버전 접미사 필수
#     us.anthropic.claude-sonnet-4-5-20250929-v1:0
#
#   짧은 ID를 보고 "잘렸다"고 판단하지 마세요. 4.6 세대는 원래 짧습니다.
#   단, 날짜는 있는데 -v1:0 이 없으면 잘린 값이라 호출이 실패합니다.
#
# 접두사와 BEDROCK_REGION의 지역이 맞아야 합니다.
#   (서울에서 us.* / us-east-1에서 apac.* → ValidationException)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# 응답 최대 토큰 / 샘플링
BEDROCK_MAX_TOKENS=3072
BEDROCK_TEMPERATURE=0.4

# ---------- DynamoDB ----------
TABLE_NAME=bookbot

# ---------- SSM Parameter Store ----------
# 이 경로 아래의 SecureString 파라미터를 전부 읽어옵니다.
SSM_PREFIX=/bookbot/prod

# ---------- 레이트리밋 ----------
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=150

# ---------- 도구 루프 ----------
MAX_TOOL_ITERATIONS=4
EXTERNAL_API_TIMEOUT_MS=6000

# ---------- CORS (프론트를 CloudFront가 아닌 곳에서 띄울 때만) ----------
# CloudFront 단일 오리진 구성이면 비워두세요. (same-origin이므로 CORS 불필요)
# 로컬 개발 시: http://localhost:5173
ALLOWED_ORIGINS=

# ---------- 로깅 ----------
LOG_LEVEL=info


# ============================================================
# SSM Parameter Store에 넣을 값 (환경 변수가 아님!)
# ============================================================
# /bookbot/prod/GOOGLE_BOOKS_API_KEY   (SecureString)  필수
# /bookbot/prod/HARDCOVER_TOKEN        (SecureString)  필수
#
# Open Library, Gutendex는 키가 필요 없습니다.
#
# 로컬 테스트(npm run smoke)에서는 셸 환경 변수로 대체 가능:
#   export GOOGLE_BOOKS_API_KEY=...
#   export HARDCOVER_TOKEN=...
