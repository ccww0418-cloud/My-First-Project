# ============================================================
# infra/secrets.env 로 복사해서 값을 채우세요.
#
#   cp infra/secrets.env.example infra/secrets.env
#
# ⚠️ secrets.env 는 .gitignore에 등록되어 있습니다. 절대 커밋하지 마세요.
# ============================================================

# ── 필수: Bedrock 모델 ID ───────────────────────────────────
# bash infra/00-preflight.sh 를 실행하면 사용 가능한 목록을 보여줍니다.
# 또는: Bedrock 콘솔 > 모델 카탈로그 > 모델 > "Programmatic Access" 표
#
# ⚠️ ID 형식이 두 세대로 나뉩니다.
#
#   신형 (Claude Sonnet 4.6 이후) — 날짜/버전 접미사 없음
#     ✓ anthropic.claude-sonnet-4-6          In-Region (쿼터 최저)
#     ✓ us.anthropic.claude-sonnet-4-6       Geo(US)   us-east-1 권장
#     ✓ global.anthropic.claude-sonnet-4-6   Global    처리량 최고
#
#   레거시 (Claude Opus 4.6 이전) — 날짜 + 버전 접미사 필수
#     ✓ us.anthropic.claude-sonnet-4-5-20250929-v1:0
#     ✗ anthropic.claude-sonnet-4-5-20250929   ← -v1:0 잘림, 호출 실패
#
#   짧은 ID를 보고 "잘렸다"고 판단하지 마세요. 4.6 세대는 원래 짧습니다.
#
# 리전별 접두사 (지역이 맞아야 합니다):
#   us-east-1 / us-west-2  → us.*
#   ap-northeast-2 (서울)  → apac.*
#   전 세계 라우팅         → global.*   (약 10% 저렴, 처리량 높음)
#   접두사 없음            → In-Region, 온디맨드 쿼터가 가장 낮음
#
# 비용을 아끼려면 sonnet 대신 haiku 계열을 쓰세요 (약 1/3 가격).
BEDROCK_MODEL_ID=

# ── 도서 API 키 ─────────────────────────────────────────────
# 없어도 배포는 되지만 추천 품질이 크게 떨어집니다.
# 발급 방법: docs/03-external-apis.md

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보
# (반드시 "Books API"를 사용 설정한 뒤 키를 만드세요)
GOOGLE_BOOKS_API_KEY=

# https://hardcover.app/account/api
# 'Bearer ' 접두사가 붙어 있어도 그대로 넣으면 됩니다 (코드가 정규화합니다)
HARDCOVER_TOKEN=

# 알라딘 TTB 키 — 국내 도서 담당 (한국 책을 찾으려면 사실상 필수)
# 나머지 4개 소스는 전부 영미권이라 "기생", "kisaeng" 같은 검색이 0건입니다.
# 발급: https://www.aladin.co.kr/ttb/wblog_manage.aspx  (로그인 → TTB 키, 무료·즉시)
# 쿼터: 하루 5,000회
ALADIN_TTB_KEY=

# 국립중앙도서관 — 국내 서지 기준점 (납본 기관이라 국내 출간서가 사실상 전부)
# 알라딘이 모르는 절판·구간·학술서를 채웁니다
# 발급: https://www.nl.go.kr/NL/contents/N31101030700.do
# 주의: 오류도 HTTP 200 으로 옵니다 (errorCode 로 판단)
NLK_API_KEY=

# ── 선택: 알람 수신 이메일 ──────────────────────────────────
# 비워두면 SNS 주제만 만들고 구독은 건너뜁니다.
ALERT_EMAIL=

# ── 선택: Open Library 요청용 연락처 ────────────────────────
# Open Library는 User-Agent에 연락처를 요구합니다. 없으면 차단될 수 있습니다.
CONTACT_EMAIL=
